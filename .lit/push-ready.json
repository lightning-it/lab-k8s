{
  "version": 1,
  "checks": [
    {
      "name": "repository-quality",
      "command": [
        "python3",
        "scripts/lit-repository-quality.py"
      ]
    },
    {
      "name": "diff-check",
      "command": [
        "git",
        "diff",
        "--check"
      ]
    }
  ],
  "remote_only_checks": [
    "GitHub token and permission behavior",
    "GitHub-hosted runner and external service availability",
    "Required Copilot review on the pull request head SHA"
  ],
  "copilot": {
    "max_diff_bytes": 200000
  }
}
