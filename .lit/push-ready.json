{
  "version": 2,
  "base_ref": "refs/remotes/origin/develop",
  "checks": [
    {
      "name": "repository-quality-profile",
      "command": ["scripts/lit-ci-profile.sh", "repository-quality"]
    }
  ],
  "remote_only_checks": [
    {
      "id": "github-actions-service-boundary",
      "workflow": ".github/workflows/repository-quality.yml",
      "job": "quality",
      "reason": "Checkout and artifact persistence require the GitHub Actions event and service context.",
      "owner": "Lightning IT Application Platform Maintainers"
    },
    {
      "id": "copilot-current-head-review",
      "workflow": ".github/workflows/copilot-review.yml",
      "job": "verify-current-revision-policy",
      "reason": "The authoritative Copilot pull-request review is produced and bound to the current head SHA by GitHub.",
      "owner": "Lightning IT Application Platform Maintainers"
    }
  ],
  "review": {
    "max_diff_bytes": 200000
  },
  "evidence": {
    "max_age_seconds": 86400
  },
  "agents": {
    "copilot": {
      "enabled": false,
      "required": false,
      "command": ["copilot"],
      "timeout_seconds": 600
    },
    "codex": {
      "enabled": false,
      "required": false,
      "command": ["codex"],
      "timeout_seconds": 900
    }
  }
}
